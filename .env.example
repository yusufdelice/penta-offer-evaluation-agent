# Uygulama Ayarları
APP_NAME="Teklif Ön Değerlendirme Agent API"
VERSION="1.0.0"

# İş Kuralları Eşik Değerleri
CRITICAL_MARGIN_THRESHOLD=10.0
HIGH_VALUE_THRESHOLD=100000.0
HIGH_DISCOUNT_THRESHOLD=15.0
STOCK_COVERAGE_THRESHOLD=0.7

# LLM Ayarları
# LLM_MODE: 'mock' veya 'groq'
LLM_MODE=mock
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile  # veya qwen/qwen3.8-27b
